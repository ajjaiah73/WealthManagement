# Copy to backend/.env. Never commit real secrets; .env is git-ignored.

# --- Runtime ---------------------------------------------------------------
DEMO_MODE=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","http://localhost:8081"]
MAX_ITERATIONS=3
RATE_LIMIT_ENABLED=false

# --- LLM agents (Intent, Advisory Synthesis, rationale narrative) -----------
# Server-side only: the key is never sent to the browser. With USE_REAL_LLM=false
# (or no key) every agent uses its deterministic implementation.
USE_REAL_LLM=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# --- Persistence ------------------------------------------------------------
# SQLite by default; for PostgreSQL (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://advisory:advisory@localhost:55432/advisory
DATABASE_URL=sqlite:///./data/advisory.db

# --- Hybrid retrieval ---------------------------------------------------------
# "hybrid" = Qdrant dense + BM25 + knowledge graph, RRF fusion, cross-encoder rerank.
# "mock"   = deterministic keyword ranking (no model downloads).
RETRIEVAL_BACKEND=hybrid
MODELS_DIR=./data/models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Qdrant server (empty = embedded on-disk Qdrant at QDRANT_PATH)
QDRANT_URL=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=superannuation_documents
# Neo4j (empty = in-process networkx graph)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Auth -------------------------------------------------------------------
AUTH_ENABLED=true
# Set a long random value in any shared environment; empty = random per process
# (tokens are invalidated on restart).
JWT_SECRET=
JWT_EXPIRY_MINUTES=480
# Optional bootstrap admin (in addition to the DEMO_MODE demo users)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
